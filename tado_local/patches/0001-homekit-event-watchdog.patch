+    def get_event_health(self) -> dict:
+        """Health of the HomeKit event stream, for /status."""
+        now = time.time()
+        since = now - self.last_event_time if self.last_event_time else None
+        return {
+            "events_active": self.events_active,
+            "connected": bool(self.pairing and self.pairing.is_connected),
+            "supports_subscribe": bool(self.pairing and self.pairing.supports_subscribe),
+            "last_event_at": self.last_event_time,
+            "seconds_since_last_event": int(since) if since is not None else None,
+            "stale_timeout": self.event_stale_timeout,
+            "stale": self.is_event_stream_stale(now),
+            "recovery_attempts": self.recovery_attempts,
+            "recovery_count": self.recovery_count,
+            "last_recovery_at": self.last_recovery_time,
+            "last_recovery_action": self.last_recovery_action,
+        }
+
+    def is_event_stream_stale(self, now: Optional[float] = None) -> bool:
+        """True when events are expected but none arrived within the stale timeout."""
+        if not self.events_active or self.event_stale_timeout <= 0 or not self.last_event_time:
+            return False
+        return (now or time.time()) - self.last_event_time > self.event_stale_timeout
+
+    async def event_watchdog_loop(self):
+        """Recover the HomeKit event stream when it goes quiet.
+
+        HomeKit only sends events on change, so silence alone is not proof of
+        failure, but resubscribing is idempotent and cheap. Each stale episode
+        escalates: first resubscribe, then drop the connection so aiohomekit
+        reconnects, re-verifies the pairing and resubscribes (what a restart did).
+        """
+        check_interval = min(60, self.event_stale_timeout)
+        while not self.is_shutting_down:
+            try:
+                await asyncio.sleep(check_interval)
+                await self.check_event_stream()
+            except asyncio.CancelledError:
+                raise
+            except Exception as e:
+                logger.error(f"Event watchdog error: {e}")
+
+    async def check_event_stream(self):
+        """Run one watchdog check and, if needed, one recovery step."""
+        if not self.pairing or not self.subscribed_characteristics:
+            return
+
+        now = time.time()
+
+        # aiohomekit permanently disables push (supports_subscribe = False) if a
+        # (re)subscribe hits a disconnect. Events then never come back on their
+        # own, so treat this as stale right away.
+        if not self.pairing.supports_subscribe:
+            logger.warning("aiohomekit disabled push subscriptions for this session; re-enabling")
+            self.pairing.supports_subscribe = True
+        elif not self.is_event_stream_stale(now):
+            return
+        elif self.last_recovery_time and now - self.last_recovery_time < self.event_stale_timeout:
+            return  # give the previous recovery step a full window to work
+
+        quiet = int(now - self.last_event_time) if self.last_event_time else None
+        self.recovery_attempts += 1
+        self.recovery_count += 1
+        self.last_recovery_time = now
+
+        if self.recovery_attempts == 1:
+            self.last_recovery_action = "resubscribe"
+            logger.warning(f"No HomeKit events for {quiet}s, resubscribing to {len(self.subscribed_characteristics)} characteristics")
+            ok = await self._resubscribe()
+            if not ok:
+                self.last_recovery_action = "reconnect"
+                logger.warning("Resubscribe failed, forcing reconnect")
+                await self._force_reconnect()
+        else:
+            self.last_recovery_action = "reconnect"
+            logger.warning(f"Still no HomeKit events for {quiet}s (attempt {self.recovery_attempts}), forcing reconnect")
+            await self._force_reconnect()
+
+        # Pick up whatever changed while events were missing. Reads may come
+        # from the bridge cache, so this is a catch-up, not a replacement for events.
+        await self._poll_characteristics(self.subscribed_characteristics, "WATCHDOG-POLL")
+
+    async def _resubscribe(self) -> bool:
+        """Send ev=true for all tracked characteristics again."""
+        try:
+            status = await self.pairing.subscribe(self.subscribed_characteristics)
+        except Exception as e:
+            logger.warning(f"Resubscribe error: {e}")
+            return False
+        if not self.pairing.supports_subscribe:
+            return False
+        rejected = {k: v for k, v in (status or {}).items() if v.get("status") != 0}
+        if rejected:
+            logger.warning(f"Resubscribe rejected for {len(rejected)} characteristics: {list(rejected.items())[:5]}")
+            return False
+        return True
+
+    async def _force_reconnect(self):
+        """Drop the transport so aiohomekit reconnects and resubscribes.
+
+        pairing.close() is not used: it marks the connection closed for good.
+        Closing the transport takes aiohomekit's normal connection-lost path,
+        which reconnects, runs pair-verify and resubscribes everything.
+        """
+        connection = self.pairing.connection
+        if connection.transport:
+            connection.transport.close()
+        try:
+            await asyncio.wait_for(connection.ensure_connection(), timeout=30)
+            logger.info("Reconnected to HomeKit bridge")
+        except Exception as e:
+            logger.warning(f"Reconnect not finished yet ({e}); aiohomekit keeps retrying")
+
     async def setup_polling_system(self):
         """Setup polling system for comparison with events."""
         try:
