diff --git a/tests/test_event_watchdog.py b/tests/test_event_watchdog.py
new file mode 100644
index 0000000..37eaa4d
--- /dev/null
+++ b/tests/test_event_watchdog.py
@@ -0,0 +1,149 @@
+import asyncio
+import time
+
+import pytest
+
+from tado_local.api import TadoLocalAPI
+
+
+class FakeTransport:
+    def __init__(self, connection):
+        self.connection = connection
+
+    def close(self):
+        self.connection.transport = None
+        self.connection.closed_count += 1
+
+
+class FakeConnection:
+    def __init__(self):
+        self.transport = FakeTransport(self)
+        self.closed_count = 0
+
+    async def ensure_connection(self):
+        self.transport = FakeTransport(self)
+
+
+class FakePairing:
+    def __init__(self, subscribe_status=None, subscribe_error=None):
+        self.connection = FakeConnection()
+        self.supports_subscribe = True
+        self.subscribe_calls = 0
+        self.subscribe_status = subscribe_status or {}
+        self.subscribe_error = subscribe_error
+        self.polled = []
+
+    @property
+    def is_connected(self):
+        return self.connection.transport is not None
+
+    async def subscribe(self, chars):
+        self.subscribe_calls += 1
+        if self.subscribe_error:
+            raise self.subscribe_error
+        return self.subscribe_status
+
+    async def get_characteristics(self, chars):
+        self.polled.extend(chars)
+        return {}
+
+
+def make_api(tmp_path, pairing, timeout=600):
+    api = TadoLocalAPI(str(tmp_path / "t.db"), event_stale_timeout=timeout)
+    api.pairing = pairing
+    api.subscribed_characteristics = [(1, 10), (2, 10)]
+    api.change_tracker = {'last_values': {}, 'events_received': 0, 'polling_changes': 0}
+    api.events_active = True
+    api.last_event_time = time.time()
+    return api
+
+
+@pytest.mark.asyncio
+async def test_fresh_stream_does_nothing(tmp_path):
+    pairing = FakePairing()
+    api = make_api(tmp_path, pairing)
+    await api.check_event_stream()
+    assert pairing.subscribe_calls == 0
+    assert api.is_event_stream_stale() is False
+    assert api.get_event_health()["stale"] is False
+
+
+@pytest.mark.asyncio
+async def test_stale_resubscribes_then_reconnects(tmp_path):
+    pairing = FakePairing()
+    api = make_api(tmp_path, pairing)
+    api.last_event_time = time.time() - 700
+    assert api.is_event_stream_stale()
+
+    await api.check_event_stream()
+    assert pairing.subscribe_calls == 1
+    assert pairing.connection.closed_count == 0
+    assert api.last_recovery_action == "resubscribe"
+    assert pairing.polled == api.subscribed_characteristics
+
+    # Within the same window nothing more happens
+    await api.check_event_stream()
+    assert pairing.subscribe_calls == 1
+
+    # Next window still silent -> reconnect
+    api.last_recovery_time -= 700
+    await api.check_event_stream()
+    assert pairing.connection.closed_count == 1
+    assert pairing.is_connected
+    assert api.last_recovery_action == "reconnect"
+    assert api.recovery_attempts == 2
+
+
+@pytest.mark.asyncio
+async def test_rejected_resubscribe_reconnects_immediately(tmp_path):
+    pairing = FakePairing(subscribe_status={(1, 10): {"status": -70402, "description": "x"},
+                                            (2, 10): {"status": 0, "description": "ok"}})
+    api = make_api(tmp_path, pairing)
+    api.last_event_time = time.time() - 700
+    await api.check_event_stream()
+    assert pairing.connection.closed_count == 1
+    assert api.last_recovery_action == "reconnect"
+
+
+@pytest.mark.asyncio
+async def test_all_ok_status_rows_count_as_success(tmp_path):
+    pairing = FakePairing(subscribe_status={(1, 10): {"status": 0, "description": "ok"}})
+    api = make_api(tmp_path, pairing)
+    api.last_event_time = time.time() - 700
+    await api.check_event_stream()
+    assert pairing.connection.closed_count == 0
+
+
+@pytest.mark.asyncio
+async def test_disabled_push_is_reenabled_without_waiting(tmp_path):
+    pairing = FakePairing()
+    pairing.supports_subscribe = False
+    api = make_api(tmp_path, pairing)
+    await api.check_event_stream()
+    assert pairing.supports_subscribe is True
+    assert pairing.subscribe_calls == 1
+
+
+@pytest.mark.asyncio
+async def test_event_resets_episode(tmp_path):
+    pairing = FakePairing()
+    api = make_api(tmp_path, pairing)
+    api.recovery_attempts = 3
+    api.pairing.dispatcher_connect = lambda cb: setattr(api, "_cb", cb)
+    api.accessories_cache = []
+    api.change_tracker['event_characteristics'] = set()
+    # setup_persistent_events registers the callback even with no characteristics
+    await api.setup_persistent_events()
+    api.last_event_time = 0
+    api._cb({})  # empty update on reconnect is not an event
+    assert api.last_event_time == 0
+    api._cb({(1, 10): {"value": 21.5}})
+    await asyncio.sleep(0)
+    assert api.last_event_time > 0
+    assert api.recovery_attempts == 0
+
+
+def test_timeout_zero_disables(tmp_path):
+    api = make_api(tmp_path, FakePairing(), timeout=0)
+    api.last_event_time = 1
+    assert api.is_event_stream_stale() is False
